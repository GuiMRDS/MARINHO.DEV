    <!-- Smooth Scroll (Lenis): carregado aqui para não bloquear a renderização -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/@studio-freight/lenis@1.0.42/dist/lenis.min.js"></script>

    <script is:inline>
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const hasFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

        // Click Ripple: desenhado dentro de um "host" que recorta o efeito,
        // sem alterar o overflow do elemento clicado (antes cortava os badges do hero).
        if (!prefersReducedMotion) {
            document.addEventListener('pointerdown', (e) => {
                const target = e.target.closest('button, a, .flashlight-card');
                if (!target) return;

                if (getComputedStyle(target).position === 'static') {
                    target.style.position = 'relative';
                }

                const rect = target.getBoundingClientRect();
                const size = Math.max(rect.width, rect.height);

                const host = document.createElement('span');
                host.className = 'ripple-host';
                const ripple = document.createElement('span');
                ripple.className = 'click-ripple';
                ripple.style.width = ripple.style.height = `${size}px`;
                ripple.style.left = `${e.clientX - rect.left - size / 2}px`;
                ripple.style.top = `${e.clientY - rect.top - size / 2}px`;

                host.appendChild(ripple);
                target.appendChild(host);
                setTimeout(() => host.remove(), 750);
            });
        }

        // Flashlight + rotação 3D: um cálculo por frame (rAF), lendo as posições
        // antes de escrever estilos e ignorando cards fora da tela.
        // Desligado em telas touch e com movimento reduzido.
        const interactiveCards = Array.from(document.querySelectorAll('.flashlight-card, .project-card'));

        if (hasFinePointer && !prefersReducedMotion) {
            let pointer = null;
            let frameQueued = false;

            const updateCards = () => {
                frameQueued = false;
                if (!pointer) return;

                const { x, y } = pointer;
                const viewportHeight = window.innerHeight;
                const measured = interactiveCards.map((card) => ({ card, rect: card.getBoundingClientRect() }));

                measured.forEach(({ card, rect }) => {
                    if (rect.bottom < 0 || rect.top > viewportHeight) return;

                    card.style.setProperty('--mouse-x', `${x - rect.left}px`);
                    card.style.setProperty('--mouse-y', `${y - rect.top}px`);

                    const isNear = x >= rect.left - 100 && x <= rect.right + 100 &&
                        y >= rect.top - 100 && y <= rect.bottom + 100;

                    if (isNear) {
                        const moveX = (x - (rect.left + rect.width / 2)) / 25;
                        const moveY = (y - (rect.top + rect.height / 2)) / 25;
                        const lift = card.classList.contains('project-card') ? ' translateY(-15px)' : '';
                        card.style.transform = `rotateX(${-moveY}deg) rotateY(${moveX}deg)${lift}`;
                    }
                });
            };

            document.addEventListener('mousemove', (e) => {
                pointer = { x: e.clientX, y: e.clientY };
                if (!frameQueued) {
                    frameQueued = true;
                    requestAnimationFrame(updateCards);
                }
            }, { passive: true });

            interactiveCards.forEach((card) => {
                card.addEventListener('mouseleave', () => {
                    card.style.transform = 'rotateX(0deg) rotateY(0deg)';
                });
            });
        }

        // Intersection Observer for Scroll Reveals
        const revealObserver = new IntersectionObserver((entries, observer) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('active');
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

        document.querySelectorAll('.reveal-in, .reveal-stagger, .image-reveal').forEach((el) => revealObserver.observe(el));

        // Preloader: sai assim que as fontes carregam (mínimo de ~1s para a animação
        // e máximo de ~2,5s), em vez de esperar o "load" de todas as imagens + 2s fixos.
        (() => {
            const preloader = document.getElementById('preloader');
            const logo = document.getElementById('loader-logo');
            const bar = document.getElementById('loader-bar');
            const status = document.getElementById('loader-status');
            if (!preloader || !logo || !bar || !status) return;

            // A animação completa só roda na primeira visita da sessão;
            // nas seguintes o preloader sai logo que as fontes estiverem prontas.
            let seenBefore = false;
            try {
                seenBefore = sessionStorage.getItem('preloader-seen') === '1';
                sessionStorage.setItem('preloader-seen', '1');
            } catch (_) { /* storage bloqueado: segue com a animação normal */ }

            const startedAt = performance.now();
            const minVisible = prefersReducedMotion || seenBefore ? 0 : 1000;

            setTimeout(() => {
                logo.style.transform = 'translateY(0)';
                status.style.transform = 'translateY(0)';
                bar.style.width = '100%';
            }, 100);

            const fontsReady = document.fonts ? document.fonts.ready : Promise.resolve();
            const maxWait = new Promise((resolve) => setTimeout(resolve, seenBefore ? 600 : 2500));

            Promise.race([fontsReady, maxWait]).then(() => {
                const remaining = Math.max(0, minVisible - (performance.now() - startedAt));
                setTimeout(() => {
                    preloader.style.opacity = '0';
                    preloader.style.visibility = 'hidden';

                    const heroContent = document.getElementById('hero-content');
                    const heroImage = document.getElementById('hero-image');
                    if (heroContent) heroContent.classList.add('active');
                    if (heroImage) heroImage.classList.add('active');
                }, remaining);
            });
        })();

        // Smooth Scroll (Lenis) — desligado com movimento reduzido
        let lenis = null;
        if (!prefersReducedMotion && typeof Lenis !== 'undefined') {
            lenis = new Lenis({
                duration: 1.2,
                easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
                orientation: 'vertical',
                gestureOrientation: 'vertical',
                smoothWheel: true,
                wheelMultiplier: 1,
                smoothTouch: false,
                touchMultiplier: 2,
                infinite: false,
            });

            const raf = (time) => {
                lenis.raf(time);
                requestAnimationFrame(raf);
            };
            requestAnimationFrame(raf);
        }

        const scrollToTarget = (selector) => {
            if (selector === '#hero') {
                if (lenis) lenis.scrollTo(0);
                else window.scrollTo({ top: 0, behavior: prefersReducedMotion ? 'auto' : 'smooth' });
                return;
            }

            const el = document.querySelector(selector);
            if (!el) return;

            if (lenis) {
                lenis.scrollTo(el, { offset: -50, duration: 1.5 });
            } else {
                const top = el.getBoundingClientRect().top + window.scrollY - 50;
                window.scrollTo({ top, behavior: prefersReducedMotion ? 'auto' : 'smooth' });
            }
        };

        // Handle Anchor Links
        document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
            anchor.addEventListener('click', (e) => {
                const selector = anchor.getAttribute('href');
                if (!selector || selector.length < 2) return;
                e.preventDefault();
                scrollToTarget(selector);
            });
        });

        // Back to Top button
        const backToTopBtn = document.getElementById('back-to-top-btn');
        if (backToTopBtn) {
            backToTopBtn.addEventListener('click', () => scrollToTarget('#hero'));
        }

        // Setas do carrossel de destaques
        (() => {
            const slider = document.getElementById('highlights-slider');
            const prev = document.getElementById('highlights-prev');
            const next = document.getElementById('highlights-next');
            if (!slider || !prev || !next) return;

            const step = () => {
                const item = slider.querySelector('.slider-item');
                const gap = parseFloat(getComputedStyle(slider).columnGap) || 0;
                return item ? item.getBoundingClientRect().width + gap : slider.clientWidth;
            };

            const updateArrows = () => {
                const maxScroll = slider.scrollWidth - slider.clientWidth - 2;
                prev.disabled = slider.scrollLeft <= 2;
                next.disabled = slider.scrollLeft >= maxScroll;
            };

            const behavior = prefersReducedMotion ? 'auto' : 'smooth';
            prev.addEventListener('click', () => slider.scrollBy({ left: -step(), behavior }));
            next.addEventListener('click', () => slider.scrollBy({ left: step(), behavior }));
            slider.addEventListener('scroll', updateArrows, { passive: true });
            window.addEventListener('resize', updateArrows);
            updateArrows();
        })();

        // Navbar + progresso da timeline: um único listener de scroll
        // (o Lenis rola a janela nativamente, então o evento dispara nos dois casos).
        const nav = document.getElementById('main-nav');
        const timelineProgress = document.querySelector('.timeline-progress');
        const timelineStart = document.getElementById('timeline-start');
        const timelineEnd = document.getElementById('timeline-end');

        const onScroll = () => {
            if (nav) nav.classList.toggle('scrolled', window.scrollY > 50);

            if (timelineProgress && timelineStart && timelineEnd) {
                const startTop = timelineStart.getBoundingClientRect().top;
                const endTop = timelineEnd.getBoundingClientRect().top;
                const playhead = window.innerHeight * 0.5;
                const percent = Math.min(Math.max(((playhead - startTop) / (endTop - startTop)) * 100, 0), 100);
                timelineProgress.style.height = `${percent}%`;
            }
        };

        let scrollQueued = false;
        window.addEventListener('scroll', () => {
            if (scrollQueued) return;
            scrollQueued = true;
            requestAnimationFrame(() => {
                scrollQueued = false;
                onScroll();
            });
        }, { passive: true });
        onScroll();
    </script>
