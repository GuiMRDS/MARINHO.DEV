---
interface Props {
  icon?: string;
  metric?: string;
  title?: string;
  description?: string;
  tag?: string;
  isPrimary?: boolean;
  // Contact specific props
  statusTitle?: string;
  statusDescription?: string;
  protocol?: string;
  protocolLabel?: string;
  availability?: string;
}

const {
  icon = "solar:mailbox-bold",
  metric,
  title,
  description,
  tag,
  isPrimary = true,
  statusTitle = "Status: Ativo",
  statusDescription = "Monitorando novas oportunidades em engenharia de software, IA, automação e segurança.",
  protocol,
  protocolLabel = "Protocolo",
  availability
} = Astro.props;

const isEvidence = Boolean(metric || title || tag);
const displayTitle = title || statusTitle;
const displayDescription = description || statusDescription;
---

<div class={`flashlight-card glass-panel bg-[#0A0A0A] border border-white/10 rounded-[2.5rem] ${isEvidence ? 'p-7 sm:p-8' : 'p-10 md:p-12'} max-w-md w-full group cursor-crosshair shadow-[0_40px_100px_rgba(0,0,0,0.8)] hover:border-primary/40 transition-all relative overflow-hidden flex flex-col justify-between h-full`}>
    <div class="relative z-10 flex flex-col gap-6">
        <!-- Top Row: Icon & Metric/Status indicator -->
        <div class="flex justify-between items-center gap-3">
            <div class={`w-14 h-14 rounded-2xl shrink-0 ${isPrimary ? 'bg-primary shadow-[0_0_30px_rgba(255,77,0,0.35)] text-white' : 'bg-white/5 border border-white/10 text-white/80'} flex items-center justify-center group-hover:scale-110 transition-all duration-700`}>
                <iconify-icon icon={icon} class="text-2xl sm:text-3xl"></iconify-icon>
            </div>
            {metric && (
                <span class={`font-oswald ${metric.length > 7 ? 'text-xl sm:text-2xl' : 'text-3xl sm:text-4xl'} font-bold ${isPrimary ? 'text-primary' : 'text-white'} tracking-tighter text-right leading-none`}>
                    {metric}
                </span>
            )}
        </div>

        <div class="space-y-2">
            {!metric && !title && (
                <div class="flex items-center gap-3 mb-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <h4 class="font-oswald text-3xl sm:text-4xl uppercase font-bold text-white tracking-tighter">
                        {displayTitle}
                    </h4>
                </div>
            )}
            {(metric || title) && (
                <h4 class="font-oswald text-xl uppercase font-bold text-white tracking-wide">
                    {displayTitle}
                </h4>
            )}
            <p class="font-space text-xs text-white/40 uppercase tracking-wider leading-relaxed">
                {displayDescription}
            </p>
        </div>

        {protocol && (
            <div class="pt-6 border-t border-white/10 flex flex-col gap-4">
                <div class="flex justify-between items-center group/item">
                    <span class="text-[10px] font-mono text-white/20 uppercase tracking-widest group-hover/item:text-white/40 transition-colors">{protocolLabel}</span>
                    <span class="text-[11px] font-mono text-primary uppercase font-bold tracking-wider">{protocol}</span>
                </div>
                {availability && (
                    <div class="flex justify-between items-center group/item">
                        <span class="text-[10px] font-mono text-white/20 uppercase tracking-widest group-hover/item:text-white/40 transition-colors">Disponibilidade</span>
                        <span class="text-[11px] font-mono text-emerald-400 uppercase font-bold tracking-wider px-3 py-1 bg-emerald-500/10 rounded-full">{availability}</span>
                    </div>
                )}
            </div>
        )}
    </div>

    {tag && (
        <div class="relative z-10 mt-6 pt-4 border-t border-white/5 flex items-center justify-between">
            <span class={`text-[9px] font-mono ${isPrimary ? 'text-primary bg-primary/10 border border-primary/20' : 'text-white/40 bg-white/5 border border-white/10'} uppercase font-bold tracking-widest px-2.5 py-1 rounded-full`}>
                {tag}
            </span>
            <iconify-icon icon="solar:arrow-right-up-linear" class="text-white/20 group-hover:text-primary transition-colors text-sm"></iconify-icon>
        </div>
    )}

    <!-- Background grid reveal on hover -->
    <div class="absolute inset-0 opacity-0 group-hover:opacity-30 transition-opacity duration-700 pointer-events-none"
        style="background-image: radial-gradient(circle at 1px 1px, #FF5C00 1px, transparent 0); background-size: 28px 28px; transform: translateZ(10px);">
    </div>

    <!-- Internal Glow -->
    <div class="absolute -inset-20 bg-primary/5 blur-[100px] opacity-0 group-hover:opacity-100 transition-opacity duration-1000">
    </div>
</div>
