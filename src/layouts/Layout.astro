---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Guilherme Marinho | Soluções Full Stack & Segurança",
	description = "Portfólio de Guilherme Marinho, desenvolvedor full stack com foco em back-end .NET e Python, IA aplicada e segurança. Projetos com ASP.NET, FastAPI, Next.js, LangChain e RAG.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/images/og-image.jpg', Astro.site); // 1200x630 JPG: formato grande no LinkedIn/WhatsApp

// Dados estruturados: ajudam o Google a ligar o site aos perfis sociais
const personJsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Guilherme Marinho Santos',
	alternateName: 'Guilherme Marinho',
	url: Astro.site?.toString(),
	image: new URL('/images/profile.jpg', Astro.site).toString(),
	jobTitle: 'Desenvolvedor Full Stack',
	address: { '@type': 'PostalAddress', addressLocality: 'Sorocaba', addressRegion: 'SP', addressCountry: 'BR' },
	alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universidade Paulista (UNIP)' },
	knowsAbout: ['C#', '.NET', 'Python', 'FastAPI', 'Next.js', 'PostgreSQL', 'LangChain', 'RAG', 'Agentes de IA', 'Docker'],
	sameAs: ['https://www.linkedin.com/in/guilherme-marinho04/', 'https://github.com/GuiMRDS'],
});
---

<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="author" content="Guilherme Marinho">
    <meta name="theme-color" content="#050505">
    <link rel="canonical" href={canonicalURL}>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">

    <!-- Open Graph / redes sociais -->
    <meta property="og:type" content="website">
    <meta property="og:locale" content="pt_BR">
    <meta property="og:site_name" content="MARINHO.DEV">
    <meta property="og:url" content={canonicalURL}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:image:type" content="image/jpeg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Guilherme Marinho — Desenvolvedor Full Stack (.NET, Python e IA aplicada)">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImage}>
    <link rel="sitemap" href="/sitemap.xml">
    <script type="application/ld+json" set:html={personJsonLd} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <!-- Carregadas sem bloquear a renderização (o preloader cobre a troca de fonte) -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&family=Space+Mono&display=swap"
        onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&family=Space+Mono&display=swap"></noscript>

    <!-- Icons -->
    <script is:inline defer src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>


</head>

<body class="antialiased overflow-x-hidden">
    <slot />
</body>

</html>
