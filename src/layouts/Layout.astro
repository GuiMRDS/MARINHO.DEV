---
interface Props {
	title?: string;
}

const { title = "Guilherme Marinho | Soluções Full Stack & Segurança" } = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&family=Space+Mono&display=swap"
        rel="stylesheet">

    <!-- Icons -->
    <script is:inline src="https://unpkg.com/lucide@latest"></script>
    <script is:inline src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>

    <!-- Tailwind CSS -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>

    <!-- Smooth Scroll (Lenis) -->
    <script is:inline src="https://cdn.jsdelivr.net/gh/studio-freight/lenis@1/bundled/lenis.min.js"></script>

    <script is:inline>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#FF5C00',
                        deep: '#E6E6E6',
                        surface: '#FFFFFF',
                        text: '#050505',
                        muted: '#666666',
                        dark: '#050505',
                        'dark-surface': '#121212',
                    },
                    fontFamily: {
                        oswald: ['Oswald', 'sans-serif'],
                        space: ['Space Grotesk', 'sans-serif'],
                        mono: ['Space Mono', 'monospace'],
                    },
                    animation: {
                        'pulse-slow': 'pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                        'marquee': 'marquee 40s linear infinite',
                    },
                    keyframes: {
                        marquee: {
                            '0%': { transform: 'translateX(0)' },
                            '100%': { transform: 'translateX(-50%)' }
                        }
                    }
                }
            }
        }
    </script>
    <style is:global>
        /* --- Custom Animations --- */
        @keyframes animationIn {
            0% {
                opacity: 0;
                transform: translateY(30px);
                filter: blur(10px);
            }

            100% {
                opacity: 1;
                transform: translateY(0);
                filter: blur(0px);
            }
        }

        @keyframes float {

            0%,
            100% {
                transform: translateY(0) rotate(0deg);
            }

            50% {
                transform: translateY(-15px) rotate(2deg);
            }
        }

        .animate-in {
            animation: animationIn 1.2s cubic-bezier(0.16, 1, 0.3, 1) both;
        }

        @keyframes shimmer {
            0% {
                background-position: -200% 0;
            }

            100% {
                background-position: 200% 0;
            }
        }

        .animate-shimmer {
            animation: shimmer 6s infinite linear;
        }

        .bg-grid {
            background-image: radial-gradient(circle at 1px 1px, rgba(0, 0, 0, 0.05) 1px, transparent 0);
            background-size: 40px 40px;
        }

        .reveal-in {
            opacity: 0;
            transform: translateY(30px);
            filter: blur(10px);
            transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .reveal-in.active {
            opacity: 1;
            transform: translateY(0);
            filter: blur(0px);
        }

        /* --- Backgrounds --- */
        .bg-grid {
            position: fixed;
            inset: 0;
            background-image: radial-gradient(circle at 1px 1px, rgba(0, 0, 0, 0.05) 1px, transparent 0);
            background-size: 40px 40px;
            pointer-events: none;
            z-index: -1;
        }

        .glass-panel {
            background: rgba(255, 255, 255, 0.6);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(0, 0, 0, 0.05);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05);
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* --- Smart Navbar: Light & Dark Mode --- */
        nav .nav-btn,
        nav .nav-btn-text {
            color: #050505 !important;
            border-color: rgba(0, 0, 0, 0.1);
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        nav .nav-btn:hover {
            background-color: #050505 !important;
            color: #FFFFFF !important;
        }

        nav.scrolled .glass-panel {
            background: rgba(5, 5, 5, 0.8);
            border-color: rgba(255, 255, 255, 0.1);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
        }

        nav.scrolled .nav-link {
            color: rgba(255, 255, 255, 0.6) !important;
        }

        nav.scrolled .nav-link:hover {
            color: #FF5C00 !important;
        }

        nav.scrolled .nav-logo {
            color: white !important;
        }

        nav.scrolled .nav-accent-bar {
            background-color: white !important;
        }

        nav.scrolled .nav-btn,
        nav.scrolled .nav-btn-text {
            color: #FFFFFF !important;
            border-color: rgba(255, 255, 255, 0.2) !important;
        }

        nav.scrolled .nav-btn:hover {
            background-color: #FFFFFF !important;
            color: #050505 !important;
        }

        /* --- Loading Screen & Reveal --- */
        #preloader {
            transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.8s;
        }

        .reveal-stagger>* {
            opacity: 0;
            transform: translateY(30px);
            filter: blur(10px);
            transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .reveal-stagger.active>* {
            opacity: 1;
            transform: translateY(0);
            filter: blur(0px);
        }

        /* Generate stagger delays */
        .reveal-stagger.active>*:nth-child(1) {
            transition-delay: 0.1s;
        }

        .reveal-stagger.active>*:nth-child(2) {
            transition-delay: 0.2s;
        }

        .reveal-stagger.active>*:nth-child(3) {
            transition-delay: 0.3s;
        }

        .reveal-stagger.active>*:nth-child(4) {
            transition-delay: 0.4s;
        }

        .reveal-stagger.active>*:nth-child(5) {
            transition-delay: 0.5s;
        }

        .image-reveal {
            clip-path: inset(0 100% 0 0);
            transition: clip-path 1.5s cubic-bezier(0.77, 0, 0.175, 1);
        }

        .image-reveal.active {
            clip-path: inset(0 0 0 0);
        }

        /* --- Interactive Smoothness & Click Feedback --- */
        button,
        a,
        .flashlight-card,
        .project-card,
        .nav-btn {
            transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);
        }

        button:active,
        a:active {
            transform: scale(0.95);
            transition-duration: 0.1s;
        }

        .click-ripple {
            position: absolute;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            transform: scale(0);
            animation: ripple-animation 0.7s cubic-bezier(0.16, 1, 0.3, 1);
            pointer-events: none;
            z-index: 50;
        }

        @keyframes ripple-animation {
            to {
                transform: scale(4);
                opacity: 0;
            }
        }

        /* --- Future UI v5 Integrations --- */
        @keyframes beam {
            0% {
                transform: translate(-50%, -50%) rotate(0deg);
            }

            100% {
                transform: translate(-50%, -50%) rotate(360deg);
            }
        }

        .flashlight-card {
            position: relative;
            overflow: hidden;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--border);
            transform-style: preserve-3d;
            perspective: 1000px;
        }

        .border-beam {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 200%;
            height: 200%;
            background: conic-gradient(from 0deg, transparent 0% 70%, #fff 100%);
            animation: beam 3s linear infinite;
            opacity: 0.1;
            transition: opacity 0.3s;
        }

        .border-beam-container:hover .border-beam {
            opacity: 0.5;
        }

        @keyframes shimmer {
            0% {
                transform: translateX(-100%) skewX(-15deg);
            }

            100% {
                transform: translateX(250%) skewX(-15deg);
            }
        }

        .animate-shimmer {
            animation: shimmer 6s infinite linear;
        }

        /* --- Interactive Effects --- */
        .flashlight-card {
            position: relative;
            transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
            transform-style: preserve-3d;
            perspective: 1000px;
        }

        .flashlight-card::before {
            content: "";
            position: absolute;
            inset: 0px;
            background: radial-gradient(600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
                    rgba(255, 92, 0, 0.15),
                    rgba(255, 92, 0, 0.05) 30%,
                    transparent 60%);
            opacity: 0;
            transition: opacity 0.5s;
            pointer-events: none;
            z-index: 10;
            border-radius: inherit;
        }

        .flashlight-card:hover::before {
            opacity: 1;
        }

        .profile-img {
            filter: grayscale(100%) contrast(110%);
            transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);
            transform: translateZ(20px);
        }

        .flashlight-card:hover .profile-img {
            filter: grayscale(0%) contrast(100%);
            transform: translateZ(40px) scale(1.05);
        }

        /* --- Floating Badges --- */
        .badge {
            position: absolute;
            background: white;
            padding: 12px 24px;
            border-radius: 99px;
            border: 1px solid rgba(0, 0, 0, 0.05);
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
            display: flex;
            align-items: center;
            gap: 10px;
            z-index: 50;
            animation: float 6s ease-in-out infinite;
            white-space: nowrap;
        }

        .badge-dark {
            background: #050505;
            color: white;
            border: none;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
        }

        /* Hide Scrollbar */
        ::-webkit-scrollbar {
            display: none;
        }

        body {
            -ms-overflow-style: none;
            scrollbar-width: none;
            background-color: #050505;
            color: #0F172A;
            overflow-x: hidden;
        }

        /* --- Section 2 Timeline Styles --- */
        .timeline-container {
            position: relative;
            padding: 0 0 100px 0;
            background-color: #050505;
            color: #E6E6E6;
            overflow: hidden;
        }

        .timeline-line {
            position: absolute;
            left: 50%;
            top: 0;
            bottom: 0;
            width: 2px;
            background: linear-gradient(to bottom, transparent, rgba(255, 92, 0, 0.2), rgba(255, 92, 0, 0.5), rgba(255, 92, 0, 0.2), transparent);
            transform: translateX(-50%);
        }

        .timeline-progress {
            position: absolute;
            left: 50%;
            top: 0;
            width: 2px;
            height: 0;
            background: #FF5C00;
            transform: translateX(-50%);
            box-shadow: 0 0 20px #FF5C00;
            z-index: 10;
            transition: height 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .glass-card:hover {
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(255, 92, 0, 0.3);
            transform: translateY(-5px);
        }

        .timeline-year {
            font-family: 'Space Mono', monospace;
            font-weight: bold;
            color: #FF5C00;
            font-size: 0.875rem;
            letter-spacing: 0.2em;
        }

        .floating-blob {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            z-index: 0;
            opacity: 0.15;
            pointer-events: none;
        }

        @media (max-width: 1024px) {
            .timeline-line,
            .timeline-progress {
                left: 30px;
                transform: none;
            }
        }

        /* --- Section 3 Projects Styles --- */
        .projects-container {
            background: linear-gradient(to bottom, #050505, #0a0b10, #08080c);
            padding: 40px 0 100px 0;
            position: relative;
            overflow: hidden;
            margin-top: -1px;
        }

        .project-card {
            position: relative;
            background: #121212;
            border-radius: 32px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.05);
            transform-style: preserve-3d;
            perspective: 1200px;
        }

        .project-card:hover {
            transform: translateY(-15px);
            border-color: rgba(255, 92, 0, 0.3);
            box-shadow: 0 40px 80px rgba(0, 0, 0, 0.6);
        }

        .project-image {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
            filter: contrast(1.1) saturate(1.1);
            image-rendering: -webkit-optimize-contrast;
            border-radius: 32px;
        }

        .project-card:hover .project-image {
            transform: scale(1.1);
            filter: brightness(1) grayscale(0%);
        }

        .project-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(0, 0, 0, 0.8) 0%, rgba(0, 0, 0, 0.2) 50%, transparent 100%);
            padding: 30px;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            z-index: 20;
            pointer-events: none;
            border-radius: 32px;
        }

        .project-content {
            transform: translateY(20px);
            opacity: 0;
            transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
            overflow: visible !important;
            transform-style: preserve-3d;
            pointer-events: auto;
        }

        .project-card:hover .project-content {
            transform: translateY(0);
            opacity: 1;
        }

        .status-badge {
            position: absolute;
            top: 20px;
            right: 20px;
            padding: 6px 12px;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border-radius: 99px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            z-index: 30;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .status-badge.production {
            background: rgba(34, 197, 94, 0.2);
            border-color: rgba(34, 197, 94, 0.3);
            color: #4ade80;
        }

        /* --- Slideshow Effect --- */
        .slideshow-image {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0;
            transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
            filter: contrast(1.1) saturate(1.1);
            image-rendering: -webkit-optimize-contrast;
            border-radius: 32px;
            animation: slideshow 16s infinite;
        }

        .project-card:hover .slideshow-image {
            transform: scale(1.1);
            filter: brightness(1) grayscale(0%);
        }

        .slideshow-image:nth-child(1) {
            animation-delay: 0s;
        }

        .slideshow-image:nth-child(2) {
            animation-delay: 4s;
        }

        .slideshow-image:nth-child(3) {
            animation-delay: 8s;
        }

        .slideshow-image:nth-child(4) {
            animation-delay: 12s;
        }

        @keyframes slideshow {

            0%,
            20% {
                opacity: 1;
            }

            25%,
            95% {
                opacity: 0;
            }

            100% {
                opacity: 0;
            }
        }

        /* --- Striking Card Variations --- */
        .card-glow-blue:hover {
            border-color: rgba(0, 157, 255, 0.4) !important;
            box-shadow: 0 0 30px rgba(0, 157, 255, 0.2) !important;
        }

        .card-glow-purple:hover {
            border-color: rgba(187, 0, 255, 0.4) !important;
            box-shadow: 0 0 30px rgba(187, 0, 255, 0.2) !important;
        }

        /* --- Slider Styles --- */
        .highlights-slider {
            display: flex;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            gap: 24px;
            padding: 20px 0 40px 0;
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        .highlights-slider::-webkit-scrollbar {
            display: none;
        }

        .slider-item {
            flex: 0 0 100%;
            scroll-snap-align: center;
        }

        @media (min-width: 768px) {
            .slider-item {
                flex: 0 0 45%;
            }
        }

        @media (min-width: 1024px) {
            .slider-item {
                flex: 0 0 31%;
            }
        }

        .slider-mask {
            position: relative;
        }

        .slider-mask::after {
            display: none;
        }
    </style>
</head>

<body class="antialiased overflow-x-hidden">
    <slot />
</body>

</html>
