---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Guilherme Marinho | Soluções Full Stack & Segurança",
	description = "Portfólio de Guilherme Marinho, desenvolvedor full stack com foco em back-end .NET e Python, IA aplicada e segurança. Projetos com ASP.NET, FastAPI, Next.js, LangChain e RAG.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/images/profile.jpg', Astro.site);
---

<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="author" content="Guilherme Marinho">
    <meta name="theme-color" content="#050505">
    <link rel="canonical" href={canonicalURL}>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">

    <!-- Open Graph / redes sociais -->
    <meta property="og:type" content="website">
    <meta property="og:locale" content="pt_BR">
    <meta property="og:site_name" content="MARINHO.DEV">
    <meta property="og:url" content={canonicalURL}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:image:alt" content="Foto de Guilherme Marinho">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImage}>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&family=Space+Mono&display=swap"
        rel="stylesheet">

    <!-- Icons -->
    <script is:inline src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>

    <!-- Smooth Scroll (Lenis) -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/@studio-freight/lenis@1.0.42/dist/lenis.min.js"></script>

</head>

<body class="antialiased overflow-x-hidden">
    <slot />
</body>

</html>
