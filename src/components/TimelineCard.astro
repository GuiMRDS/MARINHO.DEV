---
interface Tag {
  icon?: string;
  label: string;
}

interface Props {
  id?: string;
  year: string;
  yearMobile?: string;
  title: string;
  highlightText: string;
  gradientClass?: string;
  dotBorderColor?: string;
  description: string;
  tags: Tag[];
  side?: 'left' | 'right';
}

const {
  id,
  year,
  yearMobile = year,
  title,
  highlightText,
  gradientClass = 'from-[#FF5C00] to-[#FF8A00]',
  dotBorderColor = 'border-primary',
  description,
  tags,
  side = 'left'
} = Astro.props;

const isLeft = side === 'left';
---

<div id={id} class={`relative flex flex-col ${isLeft ? 'lg:flex-row' : 'lg:flex-row-reverse'} items-center justify-between group`}>
    <div class={`lg:w-[45%] ${isLeft ? 'text-right pr-12' : 'text-left pl-12'} hidden lg:block reveal-in`}>
        <span class="timeline-year">{year}</span>
    </div>
    <div class={`absolute left-1/2 -translate-x-1/2 w-4 h-4 rounded-full bg-dark border-2 ${dotBorderColor} z-20 group-hover:scale-125 transition-transform hidden lg:block`}>
    </div>
    <div class="lg:w-[45%] w-full reveal-in">
        <div class="flashlight-card glass-card p-8 rounded-2xl relative overflow-hidden">
            <div class="flex justify-between items-start mb-6">
                <h3 class="text-2xl font-oswald font-medium uppercase tracking-tight text-white">
                    {title} <span class={`bg-gradient-to-r ${gradientClass} bg-clip-text text-transparent`}>{highlightText}</span>
                </h3>
                <span class="lg:hidden timeline-year">{yearMobile}</span>
            </div>
            <p class="text-muted text-sm leading-relaxed mb-6 uppercase">
                {description}
            </p>
            <div class="flex flex-wrap gap-2">
                {tags.map((tag) => (
                    <span class="px-3 py-1 bg-white/5 border border-white/10 rounded-full text-[10px] uppercase font-mono flex items-center gap-2">
                        {tag.icon && <iconify-icon icon={tag.icon}></iconify-icon>}
                        {tag.label}
                    </span>
                ))}
            </div>
        </div>
    </div>
</div>
