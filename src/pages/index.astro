---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="Guilherme Marinho | Soluções Full Stack & Segurança">
    <!-- Preloader -->
    <div id="preloader" class="fixed inset-0 z-[100] bg-[#050505] flex flex-col items-center justify-center">
        <div class="relative">
            <div
                class="font-oswald text-5xl md:text-7xl font-bold text-white tracking-tighter uppercase mb-4 overflow-hidden">
                <span id="loader-logo"
                    class="block translate-y-full transition-transform duration-1000 pr-4">Marinho<span
                        class="text-primary italic">.dev</span></span>
            </div>
            <div class="h-[2px] w-0 bg-primary transition-all duration-1500 ease-in-out shadow-[0_0_15px_#FF5C00]"
                id="loader-bar"></div>
        </div>
        <div class="mt-8 font-mono text-[9px] text-white/20 uppercase tracking-[0.5em] overflow-hidden">
            <span id="loader-status"
                class="block translate-y-full transition-transform duration-700">System.Initialize()</span>
        </div>
    </div>

    <!-- Background Grid -->
    <div class="bg-grid"></div>

    <!-- Navigation Header -->
    <Header />

    <main>
        <!-- Hero Section -->
        <section id="hero"
            class="min-h-screen relative flex items-center justify-center px-6 pt-24 pb-12 overflow-hidden bg-white">
            <div class="max-w-[1300px] w-full grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
                <!-- Left Content -->
                <div class="relative z-10 reveal-stagger" id="hero-content">

                    <div
                        class="inline-flex items-center gap-3 px-4 py-2 bg-black/5 border border-black/10 rounded-full mb-8">
                        <span class="w-2 h-2 bg-primary rounded-full animate-pulse shadow-[0_0_10px_#FF5C00]"></span>
                        <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-muted">Disponível
                            para novos projetos</span>
                    </div>

                    <h1
                        class="text-[10vw] lg:text-[6.5rem] font-oswald font-bold leading-[0.85] uppercase tracking-tighter mb-8">
                        <span class="block">Código que</span>
                        <span
                            class="block bg-gradient-to-r from-[#FF5C00] to-[#FF8A00] bg-clip-text text-transparent">resolve.</span>
                        <span class="block text-transparent py-2"
                            style="-webkit-text-stroke: 1.5px #050505;">Segurança</span>
                        <span class="block">que protege.</span>
                    </h1>

                    <p class="max-w-lg text-base lg:text-lg text-neutral-600 font-space leading-relaxed mb-10">
                        Eu transformo ideias em soluções full stack robustas, combinando desenvolvimento limpo com
                        expertise em segurança. Para startups e empresas que precisam de mais que código—precisam de
                        confiança.
                    </p>

                    <div class="flex flex-wrap gap-4 mb-10">
                        <a href="#projetos"
                            class="group relative px-8 py-4 bg-text text-white font-bold rounded-full overflow-hidden transition-all hover:scale-105 shadow-[0_20px_50px_rgba(0,0,0,0.15)] flex items-center justify-center">
                            <span class="relative z-10 font-oswald uppercase text-xs tracking-widest">Ver
                                Projetos</span>
                            <div class="absolute inset-0 bg-white opacity-0 group-hover:opacity-10 transition-opacity">
                            </div>
                        </a>

                        <a href="#sobre"
                            class="px-8 py-4 border border-black/10 rounded-full font-oswald uppercase text-xs tracking-widest hover:bg-black/5 transition-colors flex items-center gap-3">
                            Sobre Mim
                            <iconify-icon icon="solar:arrow-right-bold" class="text-lg"></iconify-icon>
                        </a>
                    </div>

                </div>

                <!-- Right Visual -->
                <div class="relative flex justify-center lg:justify-end image-reveal" id="hero-image">
                    <div
                        class="flashlight-card glass-panel rounded-[4rem] overflow-visible aspect-[4/5] w-full max-w-[500px] group">
                        <!-- Main Image Container -->
                        <div class="w-full h-full rounded-[4rem] overflow-hidden relative">
                            <img src="/raw-files/image.png" class="profile-img w-full h-full object-cover"
                                alt="Guilherme Marinho">

                            <!-- Decorative Frame -->
                            <div
                                class="absolute inset-6 border border-black/10 rounded-[3rem] pointer-events-none group-hover:border-primary/30 transition-colors duration-500 z-20">
                            </div>
                        </div>

                        <!-- Floating Badge 1 (Top Right) -->
                        <div class="badge top-[8%] -right-[5%] shadow-2xl scale-90" style="animation-delay: 0s;">
                            <iconify-icon icon="solar:shield-check-bold"
                                style="color: #FF5C00; font-size: 18px;"></iconify-icon>
                            Security Protocol Active
                        </div>

                        <!-- Floating Badge 2 (Bottom Left) -->
                        <div class="badge badge-dark bottom-[12%] -left-[8%] shadow-2xl scale-90"
                            style="animation-delay: -3s;">
                            <iconify-icon icon="solar:cpu-bold" style="color: #FFFFFF; font-size: 18px;"></iconify-icon>
                            Full Stack Expert
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- Section 2: Timeline -->
        <section id="sobre" class="timeline-container">

            <!-- Tech Marquee (Infinite Loop) -->
            <div class="py-16 border-y border-white/5 bg-white/[0.01] overflow-hidden mb-12 relative">
                <!-- Edge Masks for smooth fade -->
                <div class="absolute inset-y-0 left-0 w-32 bg-gradient-to-r from-dark to-transparent z-10"></div>
                <div class="absolute inset-y-0 right-0 w-32 bg-gradient-to-l from-dark to-transparent z-10"></div>

                <div class="flex animate-marquee whitespace-nowrap gap-24 items-center w-max">
                    <!-- Set 1 -->
                    <div
                        class="flex items-center gap-4 text-white/10 hover:text-primary/40 transition-colors cursor-default">
                        <iconify-icon icon="simple-icons:csharp" class="text-4xl"></iconify-icon>
                        <span class="text-2xl font-oswald font-medium uppercase tracking-[0.2em]">C#</span>
                    </div>

                    <div
                        class="flex items-center gap-4 text-white/10 hover:text-primary/40 transition-colors cursor-default">
                        <iconify-icon icon="simple-icons:microsoftsqlserver" class="text-4xl"></iconify-icon>
                        <span class="text-2xl font-oswald font-medium uppercase tracking-[0.2em]">SQL Server</span>
                    </div>
                    <div
                        class="flex items-center gap-4 text-white/10 hover:text-primary/40 transition-colors cursor-default">
                        <iconify-icon icon="simple-icons:docker" class="text-4xl"></iconify-icon>
                        <span class="text-2xl font-oswald font-medium uppercase tracking-[0.2em]">Docker</span>
                    </div>

                    <div
                        class="flex items-center gap-4 text-white/10 hover:text-primary/40 transition-colors cursor-default">
                        <iconify-icon icon="simple-icons:microsoftazure" class="text-4xl"></iconify-icon>
                        <span class="text-2xl font-oswald font-medium uppercase tracking-[0.2em]">Azure</span>
                    </div>
                    <div
                        class="flex items-center gap-4 text-white/10 hover:text-primary/40 transition-colors cursor-default">
                        <iconify-icon icon="simple-icons:postgresql" class="text-4xl"></iconify-icon>
                        <span class="text-2xl font-oswald font-medium uppercase tracking-[0.2em]">PostgreSQL</span>
                    </div>
                    <div
                        class="flex items-center gap-4 text-white/10 hover:text-primary/40 transition-colors cursor-default">
                        <iconify-icon icon="simple-icons:react" class="text-4xl"></iconify-icon>
                        <span class="text-2xl font-oswald font-medium uppercase tracking-[0.2em]">React</span>
                    </div>
                    <div
                        class="flex items-center gap-4 text-white/10 hover:text-primary/40 transition-colors cursor-default">
                        <iconify-icon icon="simple-icons:nodedotjs" class="text-4xl"></iconify-icon>
                        <span class="text-2xl font-oswald font-medium uppercase tracking-[0.2em]">Node.js</span>
                    </div>

                    <!-- Set 2 (Identical for seamless loop) -->
                    <div
                        class="flex items-center gap-4 text-white/10 hover:text-primary/40 transition-colors cursor-default">
                        <iconify-icon icon="simple-icons:csharp" class="text-4xl"></iconify-icon>
                        <span class="text-2xl font-oswald font-medium uppercase tracking-[0.2em]">C#</span>
                    </div>

                    <div
                        class="flex items-center gap-4 text-white/10 hover:text-primary/40 transition-colors cursor-default">
                        <iconify-icon icon="simple-icons:microsoftsqlserver" class="text-4xl"></iconify-icon>
                        <span class="text-2xl font-oswald font-medium uppercase tracking-[0.2em]">SQL Server</span>
                    </div>
                    <div
                        class="flex items-center gap-4 text-white/10 hover:text-primary/40 transition-colors cursor-default">
                        <iconify-icon icon="simple-icons:docker" class="text-4xl"></iconify-icon>
                        <span class="text-2xl font-oswald font-medium uppercase tracking-[0.2em]">Docker</span>
                    </div>

                    <div
                        class="flex items-center gap-4 text-white/10 hover:text-primary/40 transition-colors cursor-default">
                        <iconify-icon icon="simple-icons:microsoftazure" class="text-4xl"></iconify-icon>
                        <span class="text-2xl font-oswald font-medium uppercase tracking-[0.2em]">Azure</span>
                    </div>
                    <div
                        class="flex items-center gap-4 text-white/10 hover:text-primary/40 transition-colors cursor-default">
                        <iconify-icon icon="simple-icons:postgresql" class="text-4xl"></iconify-icon>
                        <span class="text-2xl font-oswald font-medium uppercase tracking-[0.2em]">PostgreSQL</span>
                    </div>
                    <div
                        class="flex items-center gap-4 text-white/10 hover:text-primary/40 transition-colors cursor-default">
                        <iconify-icon icon="simple-icons:react" class="text-4xl"></iconify-icon>
                        <span class="text-2xl font-oswald font-medium uppercase tracking-[0.2em]">React</span>
                    </div>
                    <div
                        class="flex items-center gap-4 text-white/10 hover:text-primary/40 transition-colors cursor-default">
                        <iconify-icon icon="simple-icons:nodedotjs" class="text-4xl"></iconify-icon>
                        <span class="text-2xl font-oswald font-medium uppercase tracking-[0.2em]">Node.js</span>
                    </div>
                </div>
            </div>

            <!-- Floating Decorative Blobs -->
            <div class="floating-blob w-[400px] h-[400px] bg-primary/20 top-0 -left-48"></div>
            <div class="floating-blob w-[300px] h-[300px] bg-blue-500/10 bottom-0 -right-24"></div>

            <div class="max-w-[1300px] mx-auto px-6 relative z-10">
                <!-- Headline -->
                <div class="text-center mb-24 reveal-in">
                    <h2
                        class="text-4xl md:text-6xl font-oswald font-medium uppercase tracking-tighter leading-none mb-6 text-white">
                        Do design e infraestrutura à <br>
                        <span
                            class="bg-gradient-to-r from-[#FF5C00] via-[#FF8A00] to-[#FF2E00] bg-clip-text text-transparent italic drop-shadow-[0_0_15px_rgba(255,92,0,0.3)]">
                            Engenharia de Software, IA e Automação.</span>
                    </h2>
                    <p class="text-white/60 text-lg md:text-xl max-w-3xl mx-auto uppercase tracking-widest font-space">
                        Uma trajetória construída através de evolução contínua, desenvolvimento full stack, automação
                        inteligente e soluções modernas focadas em performance, experiência e segurança.
                    </p>
                </div>

                <!-- Timeline Path -->
                <div class="relative">
                    <div class="timeline-line"></div>
                    <div class="timeline-progress"></div>

                    <!-- Career Phases -->
                    <div class="space-y-32">
                        <!-- Phase 1: Freelancer -->
                        <div id="timeline-start"
                            class="relative flex flex-col lg:flex-row items-center justify-between group">

                            <div class="lg:w-[45%] text-right hidden lg:block pr-12 reveal-in">
                                <span class="timeline-year">2019 — 2023</span>
                            </div>
                            <div
                                class="absolute left-1/2 -translate-x-1/2 w-4 h-4 rounded-full bg-dark border-2 border-primary z-20 group-hover:scale-125 transition-transform hidden lg:block">
                            </div>
                            <div class="lg:w-[45%] w-full reveal-in">
                                <div class="flashlight-card glass-card p-8 rounded-2xl relative overflow-hidden">
                                    <div class="flex justify-between items-start mb-6">
                                        <h3
                                            class="text-2xl font-oswald font-medium uppercase tracking-tight text-white">
                                            Freelancer
                                            <span
                                                class="bg-gradient-to-r from-[#FF5C00] to-[#FF8A00] bg-clip-text text-transparent">Web
                                                & Design</span>
                                        </h3>
                                        <span class="lg:hidden timeline-year">2019-2023</span>
                                    </div>
                                    <p class="text-muted text-sm leading-relaxed mb-6 uppercase">
                                        Início da trajetória focado em criação de interfaces modernas, experiência do
                                        usuário e presença digital para pequenos negócios e clientes independentes.
                                    </p>
                                    <div class="flex flex-wrap gap-2">
                                        <span
                                            class="px-3 py-1 bg-white/5 border border-white/10 rounded-full text-[10px] uppercase font-mono flex items-center gap-2">
                                            <iconify-icon icon="simple-icons:wordpress"></iconify-icon>
                                            WordPress
                                        </span>
                                        <span
                                            class="px-3 py-1 bg-white/5 border border-white/10 rounded-full text-[10px] uppercase font-mono flex items-center gap-2">
                                            <iconify-icon icon="simple-icons:css3"></iconify-icon>
                                            CSS
                                        </span>
                                        <span
                                            class="px-3 py-1 bg-white/5 border border-white/10 rounded-full text-[10px] uppercase font-mono flex items-center gap-2">
                                            <iconify-icon icon="simple-icons:javascript"></iconify-icon>
                                            JS
                                        </span>
                                        <span
                                            class="px-3 py-1 bg-white/5 border border-white/10 rounded-full text-[10px] uppercase font-mono flex items-center gap-2">
                                            <iconify-icon icon="solar:palette-bold"></iconify-icon>
                                            UI/UX
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Phase 2: UNIP -->
                        <div class="relative flex flex-col lg:flex-row-reverse items-center justify-between group">
                            <div class="lg:w-[45%] text-left hidden lg:block pl-12 reveal-in">
                                <span class="timeline-year">2023 — 2025</span>
                            </div>
                            <div
                                class="absolute left-1/2 -translate-x-1/2 w-4 h-4 rounded-full bg-dark border-2 border-amber-400 z-20 group-hover:scale-125 transition-transform hidden lg:block">
                            </div>
                            <div class="lg:w-[45%] w-full reveal-in">
                                <div class="flashlight-card glass-card p-8 rounded-2xl relative overflow-hidden">
                                    <div class="flex justify-between items-start mb-6">
                                        <h3
                                            class="text-2xl font-oswald font-medium uppercase tracking-tight text-white">
                                            Aprendiz
                                            de <span
                                                class="bg-gradient-to-r from-amber-400 to-amber-600 bg-clip-text text-transparent">Laboratório</span>
                                            — UNIP</h3>
                                        <span class="lg:hidden timeline-year">2023-2025</span>
                                    </div>
                                    <p class="text-muted text-sm leading-relaxed mb-6 uppercase">
                                        Suporte técnico e infraestrutura. Experiência com troubleshooting, manutenção de
                                        sistemas e fundamentos de redes e segurança.
                                    </p>
                                    <div class="flex flex-wrap gap-2">
                                        <span
                                            class="px-3 py-1 bg-white/5 border border-white/10 rounded-full text-[10px] uppercase font-mono flex items-center gap-2">
                                            <iconify-icon icon="simple-icons:linux"></iconify-icon>
                                            Linux
                                        </span>
                                        <span
                                            class="px-3 py-1 bg-white/5 border border-white/10 rounded-full text-[10px] uppercase font-mono flex items-center gap-2">
                                            <iconify-icon icon="solar:shield-keyhole-bold"></iconify-icon>
                                            Infra & Security
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Phase 3: Formação Full Stack -->
                        <div class="relative flex flex-col lg:flex-row items-center justify-between group">
                            <div class="lg:w-[45%] text-right hidden lg:block pr-12 reveal-in">
                                <span class="timeline-year">2024 — 2025</span>
                            </div>
                            <div
                                class="absolute left-1/2 -translate-x-1/2 w-4 h-4 rounded-full bg-dark border-2 border-emerald-400 z-20 group-hover:scale-125 transition-transform hidden lg:block">
                            </div>
                            <div class="lg:w-[45%] w-full reveal-in">
                                <div class="flashlight-card glass-card p-8 rounded-2xl relative overflow-hidden">
                                    <div class="flex justify-between items-start mb-6">
                                        <h3
                                            class="text-2xl font-oswald font-medium uppercase tracking-tight text-white">
                                            Especialização <span
                                                class="bg-gradient-to-r from-emerald-400 to-emerald-600 bg-clip-text text-transparent">Full
                                                Stack</span></h3>
                                        <span class="lg:hidden timeline-year">2024-2025</span>
                                    </div>
                                    <p class="text-muted text-sm leading-relaxed mb-6 uppercase">
                                        Evolução técnica em Cloud, IA e Cybersecurity. Bootcamps e projetos práticos em
                                        arquitetura moderna e automação.
                                    </p>
                                    <div class="flex flex-wrap gap-2">
                                        <span
                                            class="px-3 py-1 bg-white/5 border border-white/10 rounded-full text-[10px] uppercase font-mono flex items-center gap-2">
                                            <iconify-icon icon="simple-icons:python"></iconify-icon>
                                            Python
                                        </span>
                                        <span
                                            class="px-3 py-1 bg-white/5 border border-white/10 rounded-full text-[10px] uppercase font-mono flex items-center gap-2">
                                            <iconify-icon icon="simple-icons:nextdotjs"></iconify-icon>
                                            Next.js
                                        </span>
                                        <span
                                            class="px-3 py-1 bg-white/5 border border-white/10 rounded-full text-[10px] uppercase font-mono flex items-center gap-2">
                                            <iconify-icon icon="solar:magic-stick-bold"></iconify-icon>
                                            IA & Automation
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Phase 4: FADI -->
                        <div class="relative flex flex-col lg:flex-row-reverse items-center justify-between group">
                            <div class="lg:w-[45%] text-left hidden lg:block pl-12 reveal-in">
                                <span class="timeline-year">2025 — 2026</span>
                            </div>
                            <div
                                class="absolute left-1/2 -translate-x-1/2 w-4 h-4 rounded-full bg-dark border-2 border-cyan-400 z-20 group-hover:scale-125 transition-transform hidden lg:block">
                            </div>
                            <div class="lg:w-[45%] w-full reveal-in">
                                <div class="flashlight-card glass-card p-8 rounded-2xl relative overflow-hidden">
                                    <div class="flex justify-between items-start mb-6">
                                        <h3
                                            class="text-2xl font-oswald font-medium uppercase tracking-tight text-white">
                                            Assistente
                                            de <span
                                                class="bg-gradient-to-r from-cyan-400 to-cyan-600 bg-clip-text text-transparent">TI</span>
                                            — FADI</h3>
                                        <span class="lg:hidden timeline-year">2025-2026</span>
                                    </div>
                                    <p class="text-muted text-sm leading-relaxed mb-6 uppercase">
                                        Sustentação e evolução de soluções digitais corporativas. Suporte ao ERP Sophia
                                        e administração de site institucional.
                                    </p>
                                    <div class="flex flex-wrap gap-2">
                                        <span
                                            class="px-3 py-1 bg-white/5 border border-white/10 rounded-full text-[10px] uppercase font-mono flex items-center gap-2">
                                            <iconify-icon icon="simple-icons:wordpress"></iconify-icon>
                                            WordPress
                                        </span>
                                        <span
                                            class="px-3 py-1 bg-white/5 border border-white/10 rounded-full text-[10px] uppercase font-mono flex items-center gap-2">
                                            <iconify-icon icon="solar:database-bold"></iconify-icon>
                                            ERP Sophia
                                        </span>
                                        <span
                                            class="px-3 py-1 bg-white/5 border border-white/10 rounded-full text-[10px] uppercase font-mono flex items-center gap-2">
                                            <iconify-icon icon="solar:settings-minimalistic-bold"></iconify-icon>
                                            TI Support
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Phase 5: Software Engineer -->
                        <div id="timeline-end"
                            class="relative flex flex-col lg:flex-row items-center justify-between group">

                            <div class="lg:w-[45%] text-right hidden lg:block pr-12 reveal-in">
                                <span class="timeline-year">2026 — Presente</span>
                            </div>
                            <div
                                class="absolute left-1/2 -translate-x-1/2 w-4 h-4 rounded-full bg-dark border-2 border-indigo-400 z-20 group-hover:scale-125 transition-transform hidden lg:block">
                            </div>
                            <div class="lg:w-[45%] w-full reveal-in">
                                <div class="flashlight-card glass-card p-8 rounded-2xl relative overflow-hidden">
                                    <div class="flex justify-between items-start mb-6">
                                        <h3
                                            class="text-2xl font-oswald font-medium uppercase tracking-tight text-white">
                                            Software
                                            <span
                                                class="bg-gradient-to-r from-indigo-400 to-indigo-600 bg-clip-text text-transparent">Engineer</span>
                                        </h3>
                                        <span class="lg:hidden timeline-year">2026-Pres.</span>
                                    </div>
                                    <p class="text-muted text-sm leading-relaxed mb-6 uppercase">
                                        Engenharia de Software com foco em Full Stack, IA Generativa, Automação &
                                        Infraestrutura, integrando boas práticas de segurança em todas as etapas.
                                    </p>
                                    <div class="flex flex-wrap gap-2">
                                        <span
                                            class="px-3 py-1 bg-white/5 border border-white/10 rounded-full text-[10px] uppercase font-mono flex items-center gap-2">
                                            <iconify-icon icon="simple-icons:nodedotjs"></iconify-icon>
                                            Full Stack
                                        </span>
                                        <span
                                            class="px-3 py-1 bg-white/5 border border-white/10 rounded-full text-[10px] uppercase font-mono flex items-center gap-2">
                                            <iconify-icon icon="solar:magic-stick-bold"></iconify-icon>
                                            GenAI
                                        </span>
                                        <span
                                            class="px-3 py-1 bg-white/5 border border-white/10 rounded-full text-[10px] uppercase font-mono flex items-center gap-2">
                                            <iconify-icon icon="solar:shield-check-bold"></iconify-icon>
                                            DevSecOps
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Technical Summary / Competencies -->
                <div class="mt-48 grid grid-cols-1 md:grid-cols-2 gap-12 reveal-in">
                    <div class="flashlight-card glass-card p-10 rounded-3xl">
                        <h4
                            class="text-xs font-mono bg-gradient-to-r from-[#FF5C00] to-[#FF8A00] bg-clip-text text-transparent uppercase tracking-[0.3em] mb-8 font-bold">
                            Competências Técnicas
                        </h4>
                        <ul class="space-y-6">
                            <li class="flex flex-col gap-2 border-b border-white/5 pb-4">
                                <span class="text-xs uppercase font-space text-white/40">Full Stack & Software
                                    Engineering</span>
                                <div class="flex items-center gap-4">
                                    <iconify-icon icon="simple-icons:csharp"
                                        class="text-xl text-primary/60"></iconify-icon>
                                    <iconify-icon icon="simple-icons:nextdotjs"
                                        class="text-xl text-primary/60"></iconify-icon>
                                    <iconify-icon icon="simple-icons:python"
                                        class="text-xl text-primary/60"></iconify-icon>
                                    <span class="text-sm font-mono text-muted">C#, .NET, Python, React, SOLID</span>
                                </div>
                            </li>
                            <li class="flex flex-col gap-2 border-b border-white/5 pb-4">
                                <span class="text-xs uppercase font-space text-white/40">IA, Automação &
                                    Cybersecurity</span>
                                <div class="flex items-center gap-4">
                                    <iconify-icon icon="solar:magic-stick-bold"
                                        class="text-xl text-primary/60"></iconify-icon>
