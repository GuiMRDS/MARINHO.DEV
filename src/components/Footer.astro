---
---

<!-- Footer Component -->
<footer class="mt-40 pt-20 border-t border-white/5 relative">
    <!-- Top Shadow/Fade -->
    <div
        class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[1px] bg-gradient-to-r from-transparent via-primary/50 to-transparent opacity-30">
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-16 items-start">
        <!-- Column 1: Brand & Creds -->
        <div class="flex flex-col gap-6">
            <div class="flex flex-col gap-2">
                <span
                    class="font-oswald text-3xl tracking-tighter uppercase font-bold text-white">Marinho<span
                        class="text-primary italic">.dev</span></span>
                <p
                    class="font-space text-[10px] text-white/30 uppercase tracking-[0.3em] leading-relaxed">
                    Desenvolvedor Full Stack & Segurança. <br />
                    Transformando complexidade em elegância.
                </p>
            </div>
            <div class="flex items-center gap-4">
                <div class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></div>
                <span class="font-mono text-[9px] text-white/20 uppercase tracking-widest">© 2026 Guilherme Marinho</span>
            </div>
        </div>

        <!-- Column 2: Quick Links / Navigation -->
        <div class="flex flex-col gap-8 md:items-center">
            <div class="flex flex-col gap-4">
                <span class="text-[9px] font-mono text-primary uppercase font-bold tracking-[0.5em]">//
                    Navegação</span>
                <div class="flex flex-wrap gap-x-8 gap-y-4">
                    <a href="#hero"
                        class="text-xs font-oswald uppercase tracking-widest text-white/40 hover:text-white transition-colors">Início</a>
                    <a href="#sobre"
                        class="text-xs font-oswald uppercase tracking-widest text-white/40 hover:text-white transition-colors">Sobre</a>
                    <a href="#projetos"
                        class="text-xs font-oswald uppercase tracking-widest text-white/40 hover:text-white transition-colors">Projetos</a>
                    <a href="#contato"
                        class="text-xs font-oswald uppercase tracking-widest text-white/40 hover:text-white transition-colors">Contato</a>
                </div>
            </div>
        </div>

        <!-- Column 3: Social Connectivity -->
        <div class="flex flex-col gap-8 md:items-end">
            <div class="flex flex-col gap-6 md:items-end w-full">
                <span class="text-[9px] font-mono text-primary uppercase font-bold tracking-[0.5em]">//
                    Connect</span>
                <div class="flex gap-4">
                    <a href="https://www.linkedin.com/in/guilherme-marinho04/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"
                        class="w-12 h-12 rounded-full glass-panel border border-white/10 flex items-center justify-center text-white/80 hover:text-primary hover:border-primary/50 transition-all group shadow-lg">
                        <iconify-icon icon="simple-icons:linkedin" class="text-xl"></iconify-icon>
                    </a>
                    <a href="https://github.com/GuiMRDS" target="_blank" rel="noopener noreferrer" aria-label="GitHub"
                        class="w-12 h-12 rounded-full glass-panel border border-white/10 flex items-center justify-center text-white/80 hover:text-primary hover:border-primary/50 transition-all group shadow-lg">
                        <iconify-icon icon="simple-icons:github" class="text-xl"></iconify-icon>
                    </a>
                    <a href="https://www.instagram.com/Gui.MRDS" target="_blank" rel="noopener noreferrer" aria-label="Instagram"
                        class="w-12 h-12 rounded-full glass-panel border border-white/10 flex items-center justify-center text-white/80 hover:text-primary hover:border-primary/50 transition-all group shadow-lg">
                        <iconify-icon icon="simple-icons:instagram" class="text-xl"></iconify-icon>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Big Back to Top Trigger -->
    <div class="mt-32 flex justify-center">
        <button id="back-to-top-btn"
            class="group flex flex-col items-center gap-4 cursor-pointer">
            <div
                class="w-[1px] h-12 bg-gradient-to-b from-primary to-transparent group-hover:h-20 transition-all duration-700">
            </div>
            <span
                class="text-[9px] font-mono text-white/20 uppercase tracking-[0.8em] group-hover:text-primary transition-colors">Back
                to Top</span>
        </button>
    </div>
</footer>
