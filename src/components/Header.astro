                <div class="w-2 h-6 bg-primary rounded-full"></div>
            </div>
            <span
                class="font-oswald font-bold uppercase tracking-tighter text-xl nav-logo text-neutral-900 transition-colors">Marinho.dev</span>
        </a>

        <div
            class="hidden lg:flex items-center gap-10 text-[10px] font-bold uppercase tracking-[0.2em] text-neutral-900/60">
            <a href="#hero" class="nav-link hover:text-primary transition-colors">Início</a>
            <a href="#sobre" class="nav-link hover:text-primary transition-colors">Sobre</a>
