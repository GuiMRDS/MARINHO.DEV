                        <div class="flex flex-wrap gap-8">
                            <!-- WhatsApp Button -->
                            <Button href="https://wa.me/5515991195225" target="_blank" variant="beam" size="lg" icon="logos:whatsapp-icon">
                                WhatsApp
                            </Button>

                            <!-- Email Button -->
                            <Button href="mailto:guimars22@gmail.com" variant="glass" size="lg" icon="solar:letter-bold">
