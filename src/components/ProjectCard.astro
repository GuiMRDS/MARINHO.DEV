---
import Button from './Button.astro';

interface Tag {
  icon?: string;
  label: string;
}

interface Props {
  category: string;
  /** parte branca do título (opcional) */
  title?: string;
  highlightTitle: string;
  status: string;
  statusClass?: string;
  problem: string;
  description: string;
  image: string;
  imageAlt?: string;
  /** link do código (GitHub) */
  link: string;
  /** link da aplicação no ar (opcional) */
  demo?: string;
  tags: Tag[];
  height?: string;
  /** ponto da imagem que fica no centro do card (CSS object-position), ex.: '30% 50%' */
  imagePosition?: string;
}

const {
  category,
  title = '',
  highlightTitle,
  status,
  statusClass = 'production',
  problem,
  description,
  image,
  imagePosition = '50% 50%',
  imageAlt = `${title} ${highlightTitle}`.trim(),
  link,
  demo,
  tags,
  height = 'md:h-[600px]'
} = Astro.props;
---

<div class={`project-card group border-primary/20 bg-[#08080c] ${height}`}>
    <span class={`status-badge ${statusClass}`}>{status}</span>

    <!-- Imagem: no celular fica no topo do card; a partir do md cobre o card inteiro -->
    <div class="relative h-56 sm:h-72 md:absolute md:inset-0 md:h-auto">
        <img
            src={image}
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover transition-all duration-1000 group-hover:scale-105 group-hover:brightness-110"
            style={`object-position: ${imagePosition}; image-rendering: -webkit-optimize-contrast; filter: contrast(1.1) saturate(1.1);`}
            alt={imageAlt}
        />

        <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(255,92,0,0.15),transparent_80%)]"></div>
        <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/[0.03] to-transparent pointer-events-none"></div>
        <div class="absolute inset-0 bg-[linear-gradient(110deg,transparent_40%,rgba(255,255,255,0.05)_45%,transparent_50%)] bg-[length:200%_100%] animate-shimmer pointer-events-none"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#050505] via-transparent to-transparent opacity-90"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-[#050505]/40 via-transparent to-transparent"></div>
    </div>

    <div class="project-overlay max-md:relative max-md:bg-none max-md:bg-[#08080c] max-md:pt-2 opacity-100 md:bg-gradient-to-t md:from-black md:via-black/75 md:to-black/10">
        <div class="project-content w-full">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6">
                <div class="max-w-2xl">
                    <span class="text-primary font-mono text-[10px] uppercase tracking-[0.2em] md:tracking-[0.4em] mb-3 md:mb-4 block">
                        {category}
                    </span>
                    <h3 class="text-3xl sm:text-4xl md:text-6xl font-oswald font-bold uppercase tracking-tighter text-white mb-4">
                        {title && `${title} `}<span class="bg-gradient-to-r from-[#FF5C00] to-[#FF8A00] bg-clip-text text-transparent italic text-gradient-fix">{highlightTitle}</span>
                    </h3>
                    <p class="text-white/60 text-[10px] uppercase tracking-wide md:tracking-widest font-mono mb-3">
                        Problema: {problem}
                    </p>
                    <p class="text-white/70 md:text-white/60 text-xs md:text-sm uppercase tracking-wide md:tracking-widest leading-relaxed font-space mb-6 max-w-xl">
                        {description}
                    </p>
                    <div class="flex flex-wrap gap-2 md:gap-3">
                        {tags.map((tag) => (
                            <span class="px-3 py-1.5 md:px-4 md:py-2 bg-white/5 border border-white/10 rounded-full text-[9px] uppercase font-mono flex items-center gap-2 text-white/80">
                                {tag.icon && <iconify-icon icon={tag.icon}></iconify-icon>}
                                {tag.label}
                            </span>
                        ))}
                    </div>
                </div>
                <div class="flex items-center gap-3 mb-2">
                    {demo && (
                        <Button href={demo} target="_blank" variant="glass" size="sm" icon="solar:global-bold" aria-label={`Abrir ${imageAlt} no ar`}>
                            Ver ao vivo
                        </Button>
                    )}
                    <Button href={link} target="_blank" variant="icon" icon="simple-icons:github" aria-label={`Ver código de ${imageAlt} no GitHub`}>
                    </Button>
                </div>
            </div>
        </div>
    </div>
</div>
