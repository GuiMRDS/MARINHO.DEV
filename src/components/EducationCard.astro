---
interface Props {
  title?: string;
  degree?: string;
  institution?: string;
  certifications?: string[];
}

const {
  title = "Formação Acadêmica",
  degree = "Análise e Desenvolvimento de Sistemas",
  institution = "Universidade Paulista (UNIP) — Concluído",
  certifications = [
    "Cibersegurança — DIO",
    "Analista Segurança — Cisco",
    "AI Fundamentals — Google"
  ]
} = Astro.props;
---

<div class="flashlight-card glass-card p-10 rounded-3xl flex flex-col justify-center">
    <h4 class="text-xs font-mono bg-gradient-to-r from-[#FF5C00] to-[#FF8A00] bg-clip-text text-transparent uppercase tracking-[0.3em] mb-6 font-bold">
        {title}
    </h4>
    <p class="text-xl font-oswald uppercase tracking-tight mb-2">{degree}</p>
    <p class="text-sm text-muted uppercase tracking-widest mb-6">{institution}</p>
    <div class="border-t border-white/5 pt-6 flex flex-wrap gap-2">
        {certifications.map((cert) => (
            <span class="px-2 py-1 bg-white/5 border border-white/10 rounded text-[9px] uppercase font-mono text-muted italic">
                {cert}
            </span>
        ))}
    </div>
</div>
