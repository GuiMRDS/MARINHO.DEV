    <div class="glass-panel px-8 py-4 rounded-full flex items-center justify-between">
        <a href="#hero" class="flex items-center gap-4 group cursor-pointer">
            <div class="flex gap-1">
                <div class="w-2 h-6 bg-primary rounded-full"></div>
                <div
                    class="w-2 h-6 bg-neutral-900 rounded-full nav-accent-bar group-hover:h-4 transition-all duration-300">
