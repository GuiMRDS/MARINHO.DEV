---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import TimelineCard from '../components/TimelineCard.astro';
import CompetencyCard from '../components/CompetencyCard.astro';
import EducationCard from '../components/EducationCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import HighlightProjectCard from '../components/HighlightProjectCard.astro';
import EvidenceCard from '../components/EvidenceCard.astro';
---

<Layout title="Guilherme Marinho | Soluções Full Stack & Segurança">
    <!-- Preloader -->
    <div id="preloader" class="fixed inset-0 z-[100] bg-[#050505] flex flex-col items-center justify-center">
        <div class="relative">
            <div
                class="font-oswald text-5xl md:text-7xl font-bold text-white tracking-tighter uppercase mb-4 overflow-hidden">
                <span id="loader-logo"
                    class="block translate-y-full transition-transform duration-1000 pr-4">Marinho<span
                        class="text-primary italic">.dev</span></span>
            </div>
            <div class="h-[2px] w-0 bg-primary transition-all duration-1500 ease-in-out shadow-[0_0_15px_#FF5C00]"
                id="loader-bar"></div>
        </div>
        <div class="mt-8 font-mono text-[9px] text-white/20 uppercase tracking-[0.5em] overflow-hidden">
            <span id="loader-status"
                class="block translate-y-full transition-transform duration-700">System.Initialize()</span>
        </div>
    </div>

    <!-- Background Grid -->
    <div class="bg-grid"></div>

    <!-- Navigation Header -->
    <Header />

    <main>
        <!-- Hero Section -->
        <section id="hero"
            class="min-h-screen relative flex items-center justify-center px-6 pt-24 pb-12 overflow-hidden bg-white">
            <div class="max-w-[1300px] w-full grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
                <!-- Left Content -->
                <div class="relative z-10 reveal-stagger" id="hero-content">

                    <div
                        class="inline-flex items-center gap-3 px-4 py-2 bg-black/5 border border-black/10 rounded-full mb-8">
                        <span class="w-2 h-2 bg-primary rounded-full animate-pulse shadow-[0_0_10px_#FF5C00]"></span>
                        <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-muted">Disponível
                            para novos projetos</span>
                    </div>

                    <h1
                        class="text-[10vw] lg:text-[6.5rem] font-oswald font-bold leading-[0.85] uppercase tracking-tighter mb-8">
                        <span class="block">Código que</span>
                        <span
                            class="block bg-gradient-to-r from-[#FF5C00] to-[#FF8A00] bg-clip-text text-transparent">resolve.</span>
                        <span class="block text-transparent py-2"
                            style="-webkit-text-stroke: 1.5px #050505;">Segurança</span>
                        <span class="block">que protege.</span>
                    </h1>

                    <p class="max-w-lg text-base lg:text-lg text-neutral-600 font-space leading-relaxed mb-10">
                        Eu transformo ideias em soluções full stack robustas, combinando desenvolvimento limpo com
                        expertise em segurança. Para startups e empresas que precisam de mais que código—precisam de
                        confiança.
                    </p>

                    <div class="flex flex-wrap gap-4 mb-10">
                        <Button href="#projetos" variant="primary" size="md">
                            Ver Projetos
                        </Button>

                        <Button href="#sobre" variant="outline" size="md" icon="solar:arrow-right-bold">
                            Sobre Mim
                        </Button>
                    </div>

                </div>

                <!-- Right Visual -->
                <div class="relative flex justify-center lg:justify-end image-reveal" id="hero-image">
                    <div
                        class="flashlight-card glass-panel rounded-[4rem] overflow-visible aspect-[4/5] w-full max-w-[500px] group">
                        <!-- Main Image Container -->
                        <div class="w-full h-full rounded-[4rem] overflow-hidden relative">
                            <img src="/images/profile.webp" class="profile-img w-full h-full object-cover"
                                width="640" height="641" fetchpriority="high" decoding="async"
                                alt="Guilherme Marinho">

                            <!-- Decorative Frame -->
                            <div
                                class="absolute inset-6 border border-black/10 rounded-[3rem] pointer-events-none group-hover:border-primary/30 transition-colors duration-500 z-20">
                            </div>
                        </div>

                        <!-- Floating Badge 1 (Top Right) -->
                        <div class="badge top-[8%] -right-[5%] shadow-2xl scale-90" style="animation-delay: 0s;">
                            <iconify-icon icon="solar:shield-check-bold"
                                style="color: #FF5C00; font-size: 18px;"></iconify-icon>
                            Foco em Segurança
                        </div>

                        <!-- Floating Badge 2 (Bottom Left) -->
                        <div class="badge badge-dark bottom-[12%] -left-[8%] shadow-2xl scale-90"
                            style="animation-delay: -3s;">
                            <iconify-icon icon="solar:cpu-bold" style="color: #FFFFFF; font-size: 18px;"></iconify-icon>
                            Full Stack Developer
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- Section 2: Timeline -->
        <section id="sobre" class="timeline-container">

            <!-- Tech Marquee (Infinite Loop) -->
            <div class="py-16 border-y border-white/5 bg-white/[0.01] overflow-hidden mb-12 relative">
                <!-- Edge Masks for smooth fade -->
                <div class="absolute inset-y-0 left-0 w-32 bg-gradient-to-r from-dark to-transparent z-10"></div>
                <div class="absolute inset-y-0 right-0 w-32 bg-gradient-to-l from-dark to-transparent z-10"></div>

                <div class="flex animate-marquee whitespace-nowrap gap-24 items-center w-max">
                    <!-- Set 1 -->
                    <div
                        class="flex items-center gap-4 text-white/10 hover:text-primary/40 transition-colors cursor-default">
                        <iconify-icon icon="simple-icons:csharp" class="text-4xl"></iconify-icon>
                        <span class="text-2xl font-oswald font-medium uppercase tracking-[0.2em]">C#</span>
                    </div>

                    <div
                        class="flex items-center gap-4 text-white/10 hover:text-primary/40 transition-colors cursor-default">
                        <iconify-icon icon="simple-icons:microsoftsqlserver" class="text-4xl"></iconify-icon>
                        <span class="text-2xl font-oswald font-medium uppercase tracking-[0.2em]">SQL Server</span>
                    </div>
                    <div
                        class="flex items-center gap-4 text-white/10 hover:text-primary/40 transition-colors cursor-default">
                        <iconify-icon icon="simple-icons:docker" class="text-4xl"></iconify-icon>
                        <span class="text-2xl font-oswald font-medium uppercase tracking-[0.2em]">Docker</span>
                    </div>

                    <div
                        class="flex items-center gap-4 text-white/10 hover:text-primary/40 transition-colors cursor-default">
                        <iconify-icon icon="simple-icons:python" class="text-4xl"></iconify-icon>
                        <span class="text-2xl font-oswald font-medium uppercase tracking-[0.2em]">Python</span>
                    </div>
                    <div
                        class="flex items-center gap-4 text-white/10 hover:text-primary/40 transition-colors cursor-default">
                        <iconify-icon icon="simple-icons:postgresql" class="text-4xl"></iconify-icon>
                        <span class="text-2xl font-oswald font-medium uppercase tracking-[0.2em]">PostgreSQL</span>
                    </div>
                    <div
                        class="flex items-center gap-4 text-white/10 hover:text-primary/40 transition-colors cursor-default">
                        <iconify-icon icon="simple-icons:react" class="text-4xl"></iconify-icon>
                        <span class="text-2xl font-oswald font-medium uppercase tracking-[0.2em]">React</span>
                    </div>
                    <div
                        class="flex items-center gap-4 text-white/10 hover:text-primary/40 transition-colors cursor-default">
                        <iconify-icon icon="simple-icons:nextdotjs" class="text-4xl"></iconify-icon>
                        <span class="text-2xl font-oswald font-medium uppercase tracking-[0.2em]">Next.js</span>
                    </div>
                    <div
                        class="flex items-center gap-4 text-white/10 hover:text-primary/40 transition-colors cursor-default">
                        <iconify-icon icon="simple-icons:nodedotjs" class="text-4xl"></iconify-icon>
                        <span class="text-2xl font-oswald font-medium uppercase tracking-[0.2em]">Node.js</span>
                    </div>

                    <!-- Set 2 (Identical for seamless loop) -->
                    <div
                        class="flex items-center gap-4 text-white/10 hover:text-primary/40 transition-colors cursor-default">
                        <iconify-icon icon="simple-icons:csharp" class="text-4xl"></iconify-icon>
                        <span class="text-2xl font-oswald font-medium uppercase tracking-[0.2em]">C#</span>
                    </div>

                    <div
                        class="flex items-center gap-4 text-white/10 hover:text-primary/40 transition-colors cursor-default">
                        <iconify-icon icon="simple-icons:microsoftsqlserver" class="text-4xl"></iconify-icon>
                        <span class="text-2xl font-oswald font-medium uppercase tracking-[0.2em]">SQL Server</span>
                    </div>
                    <div
                        class="flex items-center gap-4 text-white/10 hover:text-primary/40 transition-colors cursor-default">
                        <iconify-icon icon="simple-icons:docker" class="text-4xl"></iconify-icon>
                        <span class="text-2xl font-oswald font-medium uppercase tracking-[0.2em]">Docker</span>
                    </div>

                    <div
                        class="flex items-center gap-4 text-white/10 hover:text-primary/40 transition-colors cursor-default">
                        <iconify-icon icon="simple-icons:python" class="text-4xl"></iconify-icon>
                        <span class="text-2xl font-oswald font-medium uppercase tracking-[0.2em]">Python</span>
                    </div>
                    <div
                        class="flex items-center gap-4 text-white/10 hover:text-primary/40 transition-colors cursor-default">
                        <iconify-icon icon="simple-icons:postgresql" class="text-4xl"></iconify-icon>
                        <span class="text-2xl font-oswald font-medium uppercase tracking-[0.2em]">PostgreSQL</span>
                    </div>
                    <div
                        class="flex items-center gap-4 text-white/10 hover:text-primary/40 transition-colors cursor-default">
                        <iconify-icon icon="simple-icons:react" class="text-4xl"></iconify-icon>
                        <span class="text-2xl font-oswald font-medium uppercase tracking-[0.2em]">React</span>
                    </div>
                    <div
                        class="flex items-center gap-4 text-white/10 hover:text-primary/40 transition-colors cursor-default">
                        <iconify-icon icon="simple-icons:nextdotjs" class="text-4xl"></iconify-icon>
                        <span class="text-2xl font-oswald font-medium uppercase tracking-[0.2em]">Next.js</span>
                    </div>
                    <div
                        class="flex items-center gap-4 text-white/10 hover:text-primary/40 transition-colors cursor-default">
                        <iconify-icon icon="simple-icons:nodedotjs" class="text-4xl"></iconify-icon>
                        <span class="text-2xl font-oswald font-medium uppercase tracking-[0.2em]">Node.js</span>
                    </div>
                </div>
            </div>

            <!-- Floating Decorative Blobs -->
            <div class="floating-blob w-[400px] h-[400px] bg-primary/20 top-0 -left-48"></div>
            <div class="floating-blob w-[300px] h-[300px] bg-blue-500/10 bottom-0 -right-24"></div>

            <div class="max-w-[1300px] mx-auto px-4 sm:px-6 relative z-10">
                <!-- Headline -->
                <div class="text-center mb-16 sm:mb-20 md:mb-24 reveal-in">
                    <h2
                        class="text-3xl sm:text-4xl md:text-6xl font-oswald font-medium uppercase tracking-tighter leading-tight sm:leading-none mb-4 sm:mb-6 text-white">
                        Do design e infraestrutura à <br class="hidden sm:inline">
                        <span
                            class="bg-gradient-to-r from-[#FF5C00] via-[#FF8A00] to-[#FF2E00] bg-clip-text text-transparent italic drop-shadow-[0_0_15px_rgba(255,92,0,0.3)]">
                            Engenharia de Software, IA e Automação.</span>
                    </h2>
                    <p class="text-white/60 text-sm sm:text-base md:text-xl max-w-3xl mx-auto uppercase tracking-wider sm:tracking-widest font-space">
                        Uma trajetória construída através de evolução contínua, desenvolvimento full stack, automação
                        inteligente e soluções modernas focadas em performance, experiência e segurança.
                    </p>
                </div>

                <!-- Timeline Path -->
                <div class="relative pl-8 sm:pl-10 lg:pl-0">
                    <div class="timeline-line"></div>
                    <div class="timeline-progress"></div>

                    <!-- Career Phases -->
                    <div class="space-y-16 sm:space-y-24 lg:space-y-32">
                        <!-- Phase 1: Freelancer -->
                        <TimelineCard
                            id="timeline-start"
                            year="2019 — 2023"
                            yearMobile="2019-2023"
                            title="Freelancer"
                            highlightText="Web & Design"
                            gradientClass="from-[#FF5C00] to-[#FF8A00]"
                            dotBorderColor="border-primary"
                            description="Início da trajetória focado em criação de interfaces modernas, experiência do usuário e presença digital para pequenos negócios e clientes independentes."
                            tags={[
                                { icon: "simple-icons:wordpress", label: "WordPress" },
                                { icon: "simple-icons:css3", label: "CSS" },
                                { icon: "simple-icons:javascript", label: "JS" },
                                { icon: "solar:palette-bold", label: "UI/UX" }
                            ]}
                            side="left"
                        />

                        <!-- Phase 2: UNIP -->
                        <TimelineCard
                            year="2023 — 2025"
                            yearMobile="2023-2025"
                            title="Aprendiz de"
                            highlightText="Laboratório — UNIP"
                            gradientClass="from-amber-400 to-amber-600"
                            dotBorderColor="border-amber-400"
                            description="Suporte técnico e infraestrutura. Experiência com troubleshooting, manutenção de sistemas e fundamentos de redes e segurança."
                            tags={[
                                { icon: "simple-icons:linux", label: "Linux" },
                                { icon: "solar:shield-keyhole-bold", label: "Infra & Security" }
                            ]}
                            side="right"
                        />

                        <!-- Phase 3: Formação Full Stack -->
                        <TimelineCard
                            year="2024 — 2025"
                            yearMobile="2024-2025"
                            title="Especialização"
                            highlightText="Full Stack"
                            gradientClass="from-emerald-400 to-emerald-600"
                            dotBorderColor="border-emerald-400"
                            description="Evolução técnica em Cloud, IA e Cybersecurity. Bootcamps e projetos práticos em arquitetura moderna e automação."
                            tags={[
                                { icon: "simple-icons:python", label: "Python" },
                                { icon: "simple-icons:nextdotjs", label: "Next.js" },
                                { icon: "solar:magic-stick-bold", label: "IA & Automation" }
                            ]}
                            side="left"
                        />

                        <!-- Phase 4: FADI -->
                        <TimelineCard
                            year="2025 — 2026"
                            yearMobile="2025-2026"
                            title="Assistente de"
                            highlightText="TI — FADI"
                            gradientClass="from-cyan-400 to-cyan-600"
                            dotBorderColor="border-cyan-400"
                            description="Sustentação e evolução de soluções digitais corporativas. Suporte ao ERP Sophia e administração de site institucional."
                            tags={[
                                { icon: "simple-icons:wordpress", label: "WordPress" },
                                { icon: "solar:database-bold", label: "ERP Sophia" },
                                { icon: "solar:settings-minimalistic-bold", label: "TI Support" }
                            ]}
                            side="right"
                        />

                        <!-- Phase 5: Software Engineer -->
                        <TimelineCard
                            id="timeline-end"
                            year="2026 — Presente"
                            yearMobile="2026-Pres."
                            title="Software"
                            highlightText="Engineer"
                            gradientClass="from-indigo-400 to-indigo-600"
                            dotBorderColor="border-indigo-400"
                            description="Engenharia de Software com foco em Full Stack, IA Generativa, Automação & Infraestrutura, integrando boas práticas de segurança em todas as etapas."
                            tags={[
                                { icon: "simple-icons:nodedotjs", label: "Full Stack" },
                                { icon: "solar:magic-stick-bold", label: "GenAI" },
                                { icon: "solar:shield-check-bold", label: "DevSecOps" }
                            ]}
                            side="left"
                        />
                    </div>
                </div>

                <!-- Technical Summary / Competencies -->
                <div class="mt-20 sm:mt-28 md:mt-36 lg:mt-48 grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 reveal-in">
                    <CompetencyCard />
                    <EducationCard />
                </div>
            </div>
        </section>

        <!-- Section 3: Projects -->
        <section id="projetos" class="projects-container">
            <div class="max-w-[1300px] mx-auto px-6 relative z-10">
                <!-- Headline -->
                <div class="mb-16 reveal-in">
                    <h2
                        class="text-4xl md:text-6xl font-oswald font-medium uppercase tracking-tighter leading-none mb-6 text-white">
                        Problemas reais, <span
                            class="bg-gradient-to-r from-white via-white/90 to-white/40 bg-clip-text text-transparent">soluções
                            reais.</span> <br>
                        <span
                            class="bg-gradient-to-r from-[#FF5C00] via-[#FF8A00] to-[#FF2E00] bg-clip-text text-transparent italic drop-shadow-[0_0_15px_rgba(255,92,0,0.3)]">Full
                            Stack, IA e Automação.</span>
                    </h2>
                    <p class="text-white/60 text-lg md:text-xl max-w-2xl uppercase tracking-widest font-space">
                        Cada projeto resolve um problema específico — desde aplicações web completas até automações com
                        inteligência artificial.
                    </p>
                </div>

                <!-- Projects Content -->
                <div class="flex flex-col gap-16">

                    <!-- PRIMARY FEATURED PROJECTS GRID -->
                    <div class="mb-24 reveal-in flex flex-col gap-12">
                        <!-- NEXUS-AI -->
                        <ProjectCard
                            category="// IA APLICADA & RAG"
                            title="Nexus"
                            highlightTitle="AI"
                            status="🧠 AI Project"
                            statusClass="production"
                            problem="Responder perguntas sobre uma base de documentos sem inventar informações."
                            description="Assistente com RAG, busca semântica, reranqueamento e controle de alucinação, sempre citando as fontes. Testes com pytest e deploy em Docker na Oracle Cloud via GitHub Actions."
                            image="/images/projects/nexus-ai.webp"
                            imagePosition="53% 50%"
                            imageAlt="Nexus AI"
                            link="https://github.com/GuiMRDS/Nexus-AI"
                            tags={[
                                { icon: "simple-icons:python", label: "Python" },
                                { icon: "simple-icons:fastapi", label: "FastAPI" },
                                { icon: "simple-icons:langchain", label: "LangChain" },
                                { label: "ChromaDB" },
                                { icon: "simple-icons:docker", label: "Docker" }
                            ]}
                        />

                        <!-- NEWS ANALYTICS PLATFORM -->
                        <ProjectCard
                            category="// AGENTES DE IA & DADOS DE MERCADO"
                            title="News"
                            highlightTitle="Analytics"
                            status="📈 Multiagentes"
                            statusClass="production"
                            problem="Explicar ao investidor o que move o mercado, sem notícia inventada nem número errado."
                            description="Redação de agentes (Agno + Groq) que pesquisa, apura em várias fontes, checa os fatos contra dados reais da B3, Selic, CDI, IPCA e dólar e entrega a matéria com referências. Painel Quantum Terminal com telemetria do pipeline em tempo real."
                            image="/images/projects/news-analytics.webp"
                            imagePosition="0% 50%"
                            imageAlt="News Analytics Platform"
                            link="https://github.com/GuiMRDS/News_Analytics_Platform"
                            tags={[
                                { icon: "simple-icons:python", label: "Python" },
                                { label: "Agno" },
                                { label: "Groq" },
                                { icon: "simple-icons:javascript", label: "JavaScript" }
                            ]}
                        />

                        <!-- WEBPRIME MOTORS -->
                        <ProjectCard
                            category="// FULL STACK & SISTEMAS"
                            title="WebPrime"
                            highlightTitle="Motors"
                            status="💻 .NET MVC"
                            statusClass="production"
                            problem="Gerenciar catálogo de veículos, usuários e vendas em uma plataforma web."
                            description="Sistema de gestão de concessionária com ASP.NET Core MVC, Entity Framework Core (Code First), perfis de acesso Administrador e Padrão, e CRUD completo de usuários e veículos."
                            image="/images/projects/webprime-motors.webp"
                            imagePosition="27% 50%"
                            imageAlt="WebPrime Motors"
                            link="https://github.com/GuiMRDS/WebPrimeMotors"
                            tags={[
                                { icon: "simple-icons:dotnet", label: "ASP.NET MVC" },
                                { label: "EF Core" },
                                { icon: "simple-icons:microsoftsqlserver", label: "SQL Server" },
                                { icon: "simple-icons:bootstrap", label: "Bootstrap" }
                            ]}
                        />

                        <!-- XEDIT -->
                        <ProjectCard
                            category="// FULL STACK & BACK-END"
                            highlightTitle="Xedit"
                            status="🌐 Online"
                            statusClass="production"
                            problem="Construir do zero uma plataforma web com cadastro, autenticação e ativação de contas."
                            description="Projeto desenvolvido de ponta a ponta no curso.dev: API com Next.js, PostgreSQL com migrations, sessões, ativação por e-mail, testes com Jest e CI no GitHub Actions. No ar em xedit.com.br."
                            image="https://images.unsplash.com/photo-1498050108023-c5249f4df085?q=80&w=1600&auto=format&fit=crop"
                            imageAlt="Xedit"
                            link="https://github.com/GuiMRDS/xedit"
                            demo="https://xedit.com.br"
                            tags={[
                                { icon: "simple-icons:nextdotjs", label: "Next.js" },
                                { icon: "simple-icons:postgresql", label: "PostgreSQL" },
                                { icon: "simple-icons:jest", label: "Jest" },
                                { icon: "simple-icons:githubactions", label: "GitHub Actions" }
                            ]}
                        />
                    </div>

                    <!-- Header for Slider -->
                    <div class="mb-12 reveal-in">
                        <h4 class="text-xs font-mono text-white/20 uppercase tracking-[0.5em] mb-4">// Outros Destaques
                        </h4>
                        <div class="h-[1px] w-full bg-gradient-to-r from-white/10 to-transparent"></div>
                    </div>

                    <!-- HIGHLIGHTS SLIDER -->
                    <div class="slider-mask reveal-in">
                        <div class="flex justify-between items-center mb-8">
                            <h3
                                class="text-xs font-mono bg-gradient-to-r from-[#FF5C00] to-[#FF8A00] bg-clip-text text-transparent uppercase tracking-[0.4em] font-bold">
                                // FEATURED HIGHLIGHTS
                            </h3>

                            <!-- Setas do carrossel -->
                            <div class="flex items-center gap-3">
                                <button type="button" id="highlights-prev" aria-label="Projeto anterior" aria-controls="highlights-slider"
                                    class="w-12 h-12 rounded-full border border-white/10 bg-white/5 flex items-center justify-center text-white/60 hover:text-white hover:border-primary/50 hover:bg-primary/10 transition-colors disabled:opacity-30 disabled:pointer-events-none">
                                    <iconify-icon icon="solar:arrow-left-linear" class="text-xl"></iconify-icon>
                                </button>
                                <button type="button" id="highlights-next" aria-label="Próximo projeto" aria-controls="highlights-slider"
                                    class="w-12 h-12 rounded-full border border-white/10 bg-white/5 flex items-center justify-center text-white/60 hover:text-white hover:border-primary/50 hover:bg-primary/10 transition-colors disabled:opacity-30 disabled:pointer-events-none">
                                    <iconify-icon icon="solar:arrow-right-linear" class="text-xl"></iconify-icon>
                                </button>
                            </div>
                        </div>

                        <div id="highlights-slider" class="highlights-slider">
                            <!-- HIGHLIGHT: Biblioteca Virtual -->
                            <HighlightProjectCard
                                badge="📚 .NET"
                                codeTag="[ 04 // C# ]"
                                title="Biblioteca Virtual"
                                problem="Controlar acervo, usuários e empréstimos de uma biblioteca."
                                description="Sistema em C# com .NET: cadastro de livros e usuários, empréstimos, devoluções e consulta ao acervo, aplicando POO. Projeto PIM da UNIP."
                                image="https://images.unsplash.com/photo-1507842217343-583bb7270b66?q=80&w=1200&auto=format&fit=crop"
                                link="https://github.com/GuiMRDS/Biblioteca_Virtual"
                            />

                            <!-- HIGHLIGHT: FilmsPro -->
                            <HighlightProjectCard
                                badge="🎬 API"
                                codeTag="[ 05 // FASTAPI ]"
                                title="FilmsPro"
                                problem="Recomendar filmes a partir de preferências em linguagem natural."
                                description="API REST com FastAPI e agente Agno + Groq que consulta a OMDB e devolve recomendações."
                                image="/images/projects/filmspro.webp"
                                link="https://github.com/GuiMRDS/FilmsPro"
